# ============================================================
# Driplin environment variables — TEMPLATE (names only, no secrets)
#
# To run the app locally: copy this file to `.env.local` and fill in
# the values. `.env.local` is git-ignored and never leaves your machine.
# For the deployed app, set the same variables in Vercel:
#   Project → Settings → Environment Variables.
# SETUP.md explains where every value comes from.
# ============================================================

# --- Supabase (needed for feature 1: auth) ---
# Supabase dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The "service_role" key on the same page. SECRET — server-only, bypasses
# row-level security. Never shared, never in the browser.
SUPABASE_SERVICE_ROLE_KEY=

# --- Rachio (needed for feature 3) ---
# app.rach.io → Account Settings → GET API KEY
RACHIO_API_KEY=

# --- Hydrawise (needed for feature 8; leave empty until approved) ---
HYDRAWISE_API_KEY=

# --- Twilio SMS (needed for feature 6) ---
# console.twilio.com → Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Your Twilio phone number, in the format +15125551234
TWILIO_FROM_NUMBER=

# --- Resend email (needed for feature 6) ---
# resend.com → API Keys
RESEND_API_KEY=

# --- Internal ---
# A random password protecting the nightly LCRA cron endpoint (feature 4).
# Generate one at https://generate-secret.vercel.app/32 or run:
#   openssl rand -hex 32
CRON_SECRET=
# Where "LCRA reading crossed a threshold — verify the stage" emails go.
ADMIN_ALERT_EMAIL=
